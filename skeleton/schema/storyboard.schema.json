{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkeleTeller Storyboard",
  "description": "One storyboard that drives both SkeleTeller Quest (game) and SkeleTeller Storybook (slides).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project", "scenes"],
  "properties": {
    "version": { "const": "1.0" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "repository": { "$ref": "#/$defs/httpUrl" },
        "website": { "$ref": "#/$defs/httpUrl" }
      }
    },
    "theme": { "$ref": "#/$defs/theme" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_audience": { "type": "string", "maxLength": 100 },
        "created": { "type": "string", "format": "date" }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "discriminator": { "propertyName": "type" },
        "oneOf": [
          { "$ref": "#/$defs/titleScene" },
          { "$ref": "#/$defs/featureScene" },
          { "$ref": "#/$defs/calloutScene" },
          { "$ref": "#/$defs/codeScene" },
          { "$ref": "#/$defs/outroScene" }
        ]
      }
    }
  },
  "$defs": {
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "caption": { "type": "string", "minLength": 1, "maxLength": 200 },
    "narration": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "assetPath": { "type": "string", "minLength": 1 },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "background": { "$ref": "#/$defs/color" },
            "ground": { "$ref": "#/$defs/color" },
            "accent": { "$ref": "#/$defs/color" },
            "text": { "$ref": "#/$defs/color" },
            "station": { "$ref": "#/$defs/color" }
          }
        },
        "mood": { "enum": ["cozy", "neon", "spooky", "clean"] },
        "avatar": { "enum": ["explorer", "robot", "ghost"] },
        "props": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "enum": ["plant", "lamp", "crate", "sign", "bookshelf", "banner"] }
        }
      }
    },
    "titleScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title"],
      "properties": {
        "type": { "const": "title" },
        "title": { "type": "string", "minLength": 1, "maxLength": 100 },
        "tagline": { "type": "string", "minLength": 1, "maxLength": 200 },
        "background": { "$ref": "#/$defs/assetPath" }
      }
    },
    "featureScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "visual", "caption"],
      "properties": {
        "type": { "const": "feature" },
        "visual": { "$ref": "#/$defs/assetPath" },
        "caption": { "$ref": "#/$defs/caption" },
        "narration": { "$ref": "#/$defs/narration" }
      }
    },
    "calloutScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "visual", "caption", "callouts"],
      "properties": {
        "type": { "const": "callout" },
        "visual": { "$ref": "#/$defs/assetPath" },
        "caption": { "$ref": "#/$defs/caption" },
        "narration": { "$ref": "#/$defs/narration" },
        "callouts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "label"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "label": { "type": "string", "minLength": 1, "maxLength": 100 }
            }
          }
        }
      }
    },
    "codeScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "caption", "code"],
      "properties": {
        "type": { "const": "code" },
        "caption": { "$ref": "#/$defs/caption" },
        "narration": { "$ref": "#/$defs/narration" },
        "code": {
          "type": "object",
          "additionalProperties": false,
          "required": ["language", "snippet"],
          "properties": {
            "language": { "type": "string", "minLength": 1, "maxLength": 30 },
            "snippet": { "type": "string", "minLength": 1, "maxLength": 2000 },
            "highlight_lines": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "outroScene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "caption"],
      "properties": {
        "type": { "const": "outro" },
        "caption": { "$ref": "#/$defs/caption" },
        "narration": { "$ref": "#/$defs/narration" },
        "visual": { "$ref": "#/$defs/assetPath" }
      }
    }
  }
}
