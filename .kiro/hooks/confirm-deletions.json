{
  "version": "v1",
  "hooks": [
    {
      "name": "Confirm File Deletions",
      "trigger": "PreToolUse",
      "description": "Ask for confirmation before file deletion operations",
      "matcher": "delete_file",
      "action": {
        "type": "command",
        "command": "node .kiro/hooks/scripts/confirm-delete.mjs",
        "timeout": 5
      }
    }
  ]
}
